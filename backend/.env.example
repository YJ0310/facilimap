# Copy to backend/.env. Never commit the real .env file.
PORT=3000
# Relative paths are resolved from backend/, regardless of launch directory.
# Reserved for T05/T06: T04 does not create or connect to a database.
DB_PATH=../database/facilimap.db
# Reserved for future admin authentication. No admin routes exist in T04.
# Set a private random value locally before implementing authentication.
ADMIN_SECRET=
# Exact frontend origin, including scheme and port. No trailing slash.
# For VS Code Live Server this may be http://127.0.0.1:5500 instead.
CORS_ORIGIN=http://localhost:5173
